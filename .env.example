# Copy to .env and adjust values as needed
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_template
LOG_LEVEL=INFO
# auto uses readable text locally and JSON outside development/local/test
LOG_FORMAT=auto
JWT_SECRET_KEY=development-only-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=24*60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
