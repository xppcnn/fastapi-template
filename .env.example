# docling-serve 部署相关配置(复制为 .env 后填写)
# 同时被本机 Settings(docling_serve_api_key) 与 docker-compose.docling.yml 插值使用
DOCLING_SERVE_API_KEY=change-me
# 本机直连 docling-serve 的地址(容器内网为 http://docling:5001)
# DOCLING_SERVE_BASE_URL=http://localhost:5001

# Celery / Redis(默认 localhost:6379,一般无需配置)
# REDIS_URL=redis://localhost:6379/0