# Copy to .env and adjust values as needed
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_template
LOG_LEVEL=INFO
# auto uses readable text locally and JSON outside development/local/test
LOG_FORMAT=auto
JWT_SECRET_KEY=development-only-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=24*60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token

# SILO 对象存储（S3 兼容，本地 docker compose 启动）
SILO_ENDPOINT=localhost:9000
SILO_ROOT_USER=silo-admin
SILO_ROOT_PASSWORD=silo-admin
SILO_BUCKET=documents
# 本地未启用 TLS 时为 false；生产启用 TLS 后改为 true，并把 endpoint 换成域名
SILO_SECURE=false
